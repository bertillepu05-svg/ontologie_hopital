    </owl:ObjectProperty>
    


    <!-- http://www.example.org/hopital#aSpecialite -->

    <owl:ObjectProperty rdf:about="http://www.example.org/hopital#aSpecialite">
        <rdfs:domain rdf:resource="http://www.example.org/hopital#Medecin"/>
        <rdfs:range rdf:resource="http://www.example.org/hopital#Specialite"/>
    </owl:ObjectProperty>
    


    <!-- http://www.example.org/hopital#travailleDans -->

    <owl:ObjectProperty rdf:about="http://www.example.org/hopital#travailleDans">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.example.org/hopital#Infirmier"/>
                    <rdf:Description rdf:about="http://www.example.org/hopital#Medecin"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.example.org/hopital#Service"/>
    </owl:ObjectProperty>
    


