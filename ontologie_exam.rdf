    <!-- http://www.example.org/hopital#Medecin -->

    <owl:Class rdf:about="http://www.example.org/hopital#Medecin">
        <rdfs:subClassOf rdf:resource="http://www.example.org/hopital#Personne"/>
    </owl:Class>
    


    <!-- http://www.example.org/hopital#MedecinDeCardiologie -->

    <owl:Class rdf:about="http://www.example.org/hopital#MedecinDeCardiologie">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.example.org/hopital#Medecin"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.example.org/hopital#travailleDans"/>
                        <owl:hasValue rdf:resource="http://www.example.org/hopital#ServiceCardiologie"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.example.org/hopital#Medecin"/>
    </owl:Class>
    


    <!-- http://www.example.org/hopital#Patient -->

    <owl:Class rdf:about="http://www.example.org/hopital#Patient">
        <rdfs:subClassOf rdf:resource="http://www.example.org/hopital#Personne"/>
    </owl:Class>
    


    <!-- http://www.example.org/hopital#Personne -->

    <owl:Class rdf:about="http://www.example.org/hopital#Personne">
        <owl:disjointWith rdf:resource="http://www.example.org/hopital#Service"/>
    </owl:Class>
    


